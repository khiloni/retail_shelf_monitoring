/* Modern dark theme stylesheet for Retail Shelf Monitoring */

QMainWindow, QWidget {
    background-color: #1e1e24;
    color: #e0e0e0;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
}

QGroupBox {
    border: 1px solid #33333f;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 10px;
    font-weight: bold;
    color: #61afef;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}

QPushButton {
    background-color: #2d3139;
    border: 1px solid #3e4451;
    border-radius: 4px;
    padding: 6px 14px;
    color: #abb2bf;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #3e4451;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #4b5263;
}

QPushButton#btn_confirm {
    background-color: #28a745;
    color: #ffffff;
    border: none;
}

QPushButton#btn_confirm:hover {
    background-color: #218838;
}

QPushButton#btn_dismiss {
    background-color: #dc3545;
    color: #ffffff;
    border: none;
}

QPushButton#btn_dismiss:hover {
    background-color: #c82333;
}

QTableWidget, QTreeWidget, QListWidget {
    background-color: #21252b;
    border: 1px solid #282c34;
    border-radius: 4px;
    gridline-color: #2c313a;
    color: #abb2bf;
}

QHeaderView::section {
    background-color: #282c34;
    padding: 4px;
    border: 1px solid #1e1e24;
    font-weight: bold;
    color: #98c379;
}

QLabel#metrics_title {
    font-size: 14px;
    font-weight: bold;
    color: #61afef;
}

QLabel#metric_val {
    font-size: 18px;
    font-weight: bold;
    color: #98c379;
}

QStatusBar {
    background-color: #1a1a20;
    color: #7f848e;
}
